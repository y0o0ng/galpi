  "sourceEpisodes": [
    {
      "sourceEpisodeId": "p1b6-se-b002-022",
      "sourceFamilyId": "p1b6-sf-b002-022",
      "splitAssignment": "TRAIN",
      "language": "KO",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "배포할 건 강의 자료와 연습문제야."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "창문 틈으로 빗물이 들어오네, 수건을 받쳐두고 올게."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "아, 표현을 다시 할게. 강의 자료와 연습문제의 초급자용 버전."
        },
        {
          "turnId": "t4",
          "role": "USER",
          "text": "빗방울 닿던 책도 마른 쪽으로 옮겨놨어."
        },
        {
          "turnId": "t5",
          "role": "ASSISTANT",
          "text": "그 문장 그대로 기록할게."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-024",
      "sourceFamilyId": "p1b6-sf-b002-024",
      "splitAssignment": "TRAIN",
      "language": "EN",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "For the Finch workshops, use the quiet room."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "A calendar alert popped up, but it can wait until this conversation is done."
        },
        {
          "turnId": "t3",
          "role": "ASSISTANT",
          "text": "The coordinator also wrote in a separate note that morning sessions may be flexible about room choice."
        },
        {
          "turnId": "t4",
          "role": "USER",
          "text": "Give me a moment to answer the door."
        },
        {
          "turnId": "t5",
          "role": "USER",
          "text": "That part sounds useful."
        },
        {
          "turnId": "t6",
          "role": "USER",
          "text": "Let me plug in my laptop before we continue."
        },
        {
          "turnId": "t7",
          "role": "ASSISTANT",
          "text": "Okay, I will keep both notes as written."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-029",
      "sourceFamilyId": "p1b6-sf-b002-029",
      "splitAssignment": "TRAIN",
      "language": "KO",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "기본 배송은 문 앞 배송으로 적어 뒀어."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "손목시계 진동이 계속 와서 방해 금지로 바꿔둘게."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "별도 안내에는 비 오는 날 로비 수령도 가능하다고 적혀 있어."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-032",
      "sourceFamilyId": "p1b6-sf-b002-032",
      "splitAssignment": "TRAIN",
      "language": "KO",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "창고에서 의자와 테이블의 베란다용 모델 받아 와."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "책갈피가 바닥에 떨어졌네, 어느 책에서 빠졌는지 볼게."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "읽던 페이지 사이에 다시 끼워놓고 왔어."
        },
        {
          "turnId": "t4",
          "role": "ASSISTANT",
          "text": "알겠어."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-034",
      "sourceFamilyId": "p1b6-sf-b002-034",
      "splitAssignment": "TRAIN",
      "language": "EN",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "The team handbook says formal dress for client sessions. A later note says comfortable clothes are fine on remote days. Tomorrow is a remote day, and I have a client session."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-037",
      "sourceFamilyId": "p1b6-sf-b002-037",
      "splitAssignment": "TRAIN",
      "language": "MIXED",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "On the dashboard, show alerts and weekly reports for admins only."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "One moment, 배달 기사님 call만 받고 공동문을 열어줄게."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-039",
      "sourceFamilyId": "p1b6-sf-b002-039",
      "splitAssignment": "TRAIN",
      "language": "KO",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "다시 사진 내보내기 얘기로 가자. 사진은 원본 크기로 저장한다고 했고, 모바일에서는 용량을 줄여도 된다는 메모도 있어."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-047",
      "sourceFamilyId": "p1b6-sf-b002-047",
      "splitAssignment": "DEV",
      "language": "MIXED",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "Coworking lounge의 resident rate 규정을 보고 있어."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "잠깐, team chat에 urgent처럼 보이는 mention이 떠서 확인할게."
        },
        {
          "turnId": "t3",
          "role": "ASSISTANT",
          "text": "그 요금은 resident에게만 적용되고, 안내에는 resident는 보통 장기 체류 등록을 하고, 주기적으로 건물에 머물고, 개인 우편함을 쓴다고 적혀 있네."
        },
        {
          "turnId": "t4",
          "role": "USER",
          "text": "It was just a lunch poll, so 답장은 나중에 해도 되겠어."
        },
        {
          "turnId": "t5",
          "role": "USER",
          "text": "나는 장기 체류 등록은 없어."
        },
        {
          "turnId": "t6",
          "role": "USER",
          "text": "알림 badge만 지웠고 다른 channel은 열지 않았어."
        },
        {
          "turnId": "t7",
          "role": "USER",
          "text": "그래도 매주 사흘은 그 건물에 머물러."
        },
        {
          "turnId": "t8",
          "role": "USER",
          "text": "이제 notification은 muted라 편하게 continue할 수 있어."
        },
        {
          "turnId": "t9",
          "role": "USER",
          "text": "다시 rate 얘기로 돌아오면 개인 우편함도 쓰고 있어."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-049",
      "sourceFamilyId": "p1b6-sf-b002-049",
      "splitAssignment": "DEV",
      "language": "KO",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "어제 카페 앞에서 본 빨간 우산은 손잡이에 흰 스티커가 붙어 있었고 손잡이가 깨져 있었어."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "책상 조명이 깜빡여서 플러그를 한 번 단단히 꽂을게."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "오늘 역 앞에서도 흰 스티커가 붙은 빨간 우산을 봤는데 손잡이는 멀쩡하더라."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-051",
      "sourceFamilyId": "p1b6-sf-b002-051",
      "splitAssignment": "DEV",
      "language": "MIXED",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "Option B 쪽이 더 마음에 들어."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "잠깐, headphones firmware notice가 떴는데 창부터 닫을게."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "그래도 A와 C의 maintenance cost를 더 비교해 줘."
        },
        {
          "turnId": "t4",
          "role": "USER",
          "text": "Update는 tonight로 미뤘고 소리는 그대로 잘 들려."
        },
        {
          "turnId": "t5",
          "role": "ASSISTANT",
          "text": "알겠어. A와 C의 maintenance cost를 비교해 볼게."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-059",
      "sourceFamilyId": "p1b6-sf-b002-059",
      "splitAssignment": "FINAL_HELD_OUT",
      "language": "KO",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "지금 보관함 안의 문서들은 월말에 삭제하기로 했어."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "충전 케이블이 의자 바퀴에 걸렸어, 옆으로 빼둘게."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "오늘 새 초안을 그 보관함으로 옮겼어."
        }
      ]
    },
    {
      "sourceEpisodeId": "p1b6-se-b002-063",
      "sourceFamilyId": "p1b6-sf-b002-063",
      "splitAssignment": "FINAL_HELD_OUT",
      "language": "KO",
      "turns": [
        {
          "turnId": "t1",
          "role": "USER",
          "text": "지금 빨간 바구니 안의 옷은 오늘 세탁 대상이라고 정했어."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "블루투스 키보드가 절전 모드에 들어갔네, 깨우고 올게."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "다시 세탁 얘기로 돌아가면 스카프를 방금 빨간 바구니로 옮겼어."
        }
      ]
    }
  ],
