        {
          "turnId": "t1",
          "role": "USER",
          "text": "I'm comparing two desk mats for my office."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "The first one is 80 cm wide and 40 cm deep."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "My coffee went cold while I was measuring."
        },
        {
          "turnId": "t4",
          "role": "USER",
          "text": "The second one is about 5 cm bigger on one side, and the other side is the same."
        }
      ]
    },
