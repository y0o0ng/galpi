          "role": "USER",
          "text": "For context, my sister is flying in for the holidays."
        },
        {
          "turnId": "t2",
          "role": "USER",
          "text": "The garage door remote needs new batteries."
        },
        {
          "turnId": "t3",
          "role": "USER",
          "text": "She said her flight lands sometime between 3 and 4 p.m."
        },
        {
          "turnId": "t4",
