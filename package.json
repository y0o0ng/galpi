{
  "name": "galpi",
  "version": "1.0.0",
  "description": "갈피 - 대화와 지식을 축적하고 다시 꺼내 쓰는 개인 AI 비서",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "docker:test": "docker build --target test -t galpi:test .",
    "docker:up": "docker compose up --build",
    "audit:topics": "node scripts/audit-topic-store.js",
    "audit:note-index": "node scripts/audit-note-index.js",
    "plan:topic-repair": "node scripts/plan-topic-repair.js",
    "apply:topic-repair": "node scripts/apply-topic-repair.js",
    "remove:topic-qa": "node scripts/remove-topic-qa.js",
    "eval:retrieval": "node scripts/evaluate-assistant-retrieval.js",
    "eval:mail-fixtures": "node scripts/evaluate-mail-fixtures.js",
    "report:retrieval-shadow": "node scripts/report-retrieval-shadow.js",
    "report:memory-inference-pilot": "node scripts/report-memory-inference-pilot.js",
    "research:memory-inference-smoke": "node scripts/run-memory-inference-smoke.js",
    "research:memory-inference-calibration": "node scripts/run-memory-inference-calibration.js",
    "research:memory-inference-extraction-boundary": "node scripts/run-memory-inference-extraction-boundary-diagnostic.js",
    "research:memory-inference-triage-label-semantics": "node scripts/run-memory-inference-triage-label-semantics-diagnostic.js",
    "research:memory-inference-p1b2c-triage-validation": "node scripts/run-memory-inference-p1b2c-triage-validation.js",
    "research:memory-inference-p1b2d-triage-boundary": "node scripts/run-memory-inference-p1b2d-triage-boundary-diagnostic.js",
    "research:memory-inference-p1b3-4b": "node scripts/run-memory-inference-p1b3-decomposed-pipeline.js --phase 4b",
    "research:memory-inference-p1b3-1p7b": "node scripts/run-memory-inference-p1b3-decomposed-pipeline.js --phase 1.7b",
    "research:memory-inference-p1b3-combine": "node scripts/combine-memory-inference-p1b3-decomposed-pipeline.js",
    "review:memory-inference-p1b2c-triage-gold": "node scripts/review-memory-inference-p1b2c-triage-gold.js",
    "review:memory-inference-p1b2d-triage-gold": "node scripts/review-memory-inference-p1b2d-triage-gold.js",
    "review:memory-inference-p1b3-human-primary-gold": "node scripts/review-memory-inference-p1b3-human-primary-gold.js",
    "review:retrieval-policy": "node scripts/review-retrieval-policy.js",
    "research:memory-p0": "node scripts/measure-memory-p0-a.js",
    "check:codex-runner": "node scripts/check-codex-runner.js",
    "smoke:openai-responses": "node scripts/smoke-openai-responses.js",
    "smoke:github-mcp": "node scripts/smoke-github-mcp.js",
    "mcp:obsidian": "node scripts/galpi-mcp.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "dompurify": "^3.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "imapflow": "^1.7.1",
    "marked": "^18.0.4",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "postal-mime": "^3.0.0",
    "uuid": "^11.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  }
}
