# API 키 — 실제 키로 교체 (따옴표 없이 입력)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# 선택: Semantic Scholar 논문 검색 (키 없이도 동작, 키 사용 권장)
S2_API_KEY=
# 개발·문제 해결용 고정 응답. 실제 검색에서는 false 유지
PAPER_SEARCH_MOCK=false

# 모델 이름 — 오류 나면 각 콘솔에서 최신 모델명으로 교체
CLAUDE_MODEL=claude-sonnet-4-6
GPT_MODEL=gpt-5.4-mini

# V4.5-M 단일 GPT 채팅. M2 전환 전까지 false 유지
GPT_RESPONSES_ENABLED=false
GPT_CHAT_BOOTSTRAP_MODEL=gpt-5.6-terra
GPT_CHAT_REASONING_EFFORT=medium

# 검증된 topic Q&A 청크를 실제 답변 컨텍스트에 주입. A2 배포 전까지 false 유지
ASSISTANT_RETRIEVAL_A2_ENABLED=false

# OpenAI API·Codex 구독 모델 목록의 24시간 자동 갱신. 운영 전환 전까지 false 유지
MODEL_CATALOG_REFRESH_ENABLED=false

# 의회 심층(deep) 모드 전용 모델 — 설정 안 하면 아래 기본값을 쓴다.
# 이 모델명이 실제로 없으면 deep 모드 요청이 API 오류로 실패하니 콘솔에서 확인 후 교체할 것.
CLAUDE_DEEP_MODEL=claude-opus-4-5
GPT_DEEP_MODEL=gpt-5.5

# 볼트 경로 — 옵시디언 폴더의 절대 경로
VAULT_PATH=/Users/chanyongs21/Desktop/galpi/galpi-vault

# 서버 바인딩
# 로컬 개발: 127.0.0.1
# 라즈베리파이에서 같은 네트워크 기기로 접속: 0.0.0.0
HOST=127.0.0.1

# 서버 포트 (기본 3000)
PORT=3000

# 선택: 설정하면 /api 요청에 API 토큰이 필요합니다
API_TOKEN=

# 일정 정본 API. C1 전체 배포 전까지 false 유지
ASSISTANT_TASKS_ENABLED=false

# private HTTPS 홈 화면 PWA 알림. 일정 기능과 함께 켜고, Pi .env에만 private key를 둔다.
WEB_PUSH_ENABLED=false
WEB_PUSH_CANONICAL_ORIGIN=https://galpi-node.example-tailnet.ts.net
WEB_PUSH_VAPID_SUBJECT=mailto:operator@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# AI에게 보낼 최근 대화 개수 (기본 10)
CONTEXT_N=10

# Codex 정리 실행
# codex: Codex CLI 사용 / heuristic: 로컬 fallback 정리
# systemd 운영에서는 로그인 셸과 PATH가 다르므로 bare `codex`를 쓰지 않는다.
# 실제 실행을 확인한 절대 wrapper 경로를 사용한다. Pi 예: /home/pi/galpi/bin/codex
# 로컬 개발에서는 `command -v codex`로 찾은 절대 경로에 맞게 교체한다.
CODEX_RUNNER_MODE=codex
CODEX_BIN=/home/pi/galpi/bin/codex
CODEX_RUNNER_TIMEOUT_MS=180000

# Codex 정리에 쓰는 모델 (deep은 /organize all 같은 일괄 재정리용)
CODEX_MODEL=gpt-5.6-terra
CODEX_DEEP_MODEL=gpt-5.5

# 백업 저장 폴더 (볼트+DB 하루 1회 자동 백업, 7일 보관)
# 미설정 시 기본값: ~/backups/galpi
BACKUP_DIR=
