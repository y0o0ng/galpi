# API 키 — 실제 키로 교체 (따옴표 없이 입력)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# 선택: Semantic Scholar 논문 검색 (키 없이도 동작, 키 사용 권장)
S2_API_KEY=
# 개발·문제 해결용 고정 응답. 실제 검색에서는 false 유지
PAPER_SEARCH_MOCK=false

# 모델 이름 — 오류 나면 각 콘솔에서 최신 모델명으로 교체
CLAUDE_MODEL=claude-sonnet-4-6
GPT_MODEL=gpt-5.4-mini

# V4.5-M 단일 GPT 채팅. M2 전환 전까지 false 유지
GPT_RESPONSES_ENABLED=false
GPT_CHAT_BOOTSTRAP_MODEL=gpt-5.6-terra
GPT_CHAT_REASONING_EFFORT=medium

# V4-B R0 Realtime 음성. 로컬·Pi 실제 인수 전까지 false 유지
OPENAI_REALTIME_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=cedar
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MAX_SESSION_SECONDS=300
# 복잡한 음성 답변이 incomplete로 잘리지 않도록 bounded 최대값 사용
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=4096
# R1 읽기 전용 기억·활성 일정 도구. A2도 true일 때만 실제 활성화
OPENAI_REALTIME_READ_TOOLS_ENABLED=false
# R2b 턴별 보정 자막. 메시지·노트·일정 저장은 R2c 전까지 계속 0회
OPENAI_REALTIME_CORRECTION_ENABLED=false
OPENAI_REALTIME_CANONICAL_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_REALTIME_MAX_TURN_SECONDS=120
OPENAI_REALTIME_MAX_TURN_BYTES=8388608
# R2c-1 corrected-only shared-main 저장. 실기기 인수 전까지 false 유지
OPENAI_REALTIME_FINALIZE_ENABLED=false

# 검증된 topic Q&A 청크를 실제 답변 컨텍스트에 주입. A2 배포 전까지 false 유지
ASSISTANT_RETRIEVAL_A2_ENABLED=false

# OpenAI API·Codex 구독 모델 목록의 24시간 자동 갱신. 운영 전환 전까지 false 유지
MODEL_CATALOG_REFRESH_ENABLED=false

# MAIL-1 메일 에이전트 Provider 동기화. 실계정 인수 전까지 false 유지
MAIL_AGENT_ENABLED=false
# Gmail OAuth. 콘솔에서 "웹 애플리케이션" 클라이언트로 만들고, 앱은 In production으로
# 게시하되 인증은 제출하지 않는다(개인 사용 면제). 자세한 이유는 설계 문서 20.1.
MAIL_GMAIL_CLIENT_ID=
MAIL_GMAIL_CLIENT_SECRET=
MAIL_GMAIL_REFRESH_TOKEN=
# 네이버는 2단계 인증 + 애플리케이션 비밀번호가 필요하다. 일반 로그인 비밀번호를 넣지 않는다.
NAVER_MAIL_USER=
NAVER_MAIL_APP_PASSWORD=
# MAIL-2 분석 모델. 채팅 자동 모델을 상속하지 않는다 — 메일 판단은 고빈도 분류라
# 예산·교체 주기가 다르고, 채팅 모델을 바꿨다고 판단이 같이 흔들리면 안 된다.
# 바꾸기 전에 npm run eval:mail-fixtures로 같은 fixture에서 견준다.
MAIL_ANALYZER_MODEL=gpt-5.6-luna

# 의회 심층(deep) 모드 전용 모델 — 설정 안 하면 아래 기본값을 쓴다.
# 이 모델명이 실제로 없으면 deep 모드 요청이 API 오류로 실패하니 콘솔에서 확인 후 교체할 것.
CLAUDE_DEEP_MODEL=claude-opus-4-5
GPT_DEEP_MODEL=gpt-5.5

# SQLite 데이터 디렉터리. 비우면 저장소 루트를 사용하고 Docker에서는 /var/lib/galpi로 덮어쓴다.
# galpi.db, galpi.db-wal, galpi.db-shm은 항상 이 디렉터리에 함께 둔다.
GALPI_DATA_DIR=

# 볼트 경로 — 옵시디언 폴더의 절대 경로
VAULT_PATH=/path/to/galpi-vault

# 서버 바인딩
# 로컬 개발: 127.0.0.1
# 라즈베리파이에서 같은 네트워크 기기로 접속: 0.0.0.0
HOST=127.0.0.1

# 서버 포트 (기본 3000)
PORT=3000

# 선택: 설정하면 /api 요청에 API 토큰이 필요합니다
API_TOKEN=

# U0 임시 첨부 업로드. 메시지 연결·모델 읽기·UI가 붙기 전까지 false 유지
ATTACHMENTS_ENABLED=false

# 일정 정본 API. C1 전체 배포 전까지 false 유지
ASSISTANT_TASKS_ENABLED=false

# private HTTPS 홈 화면 PWA 알림. 일정 기능과 함께 켜고, Pi .env에만 private key를 둔다.
WEB_PUSH_ENABLED=false
WEB_PUSH_CANONICAL_ORIGIN=https://galpi-node.example-tailnet.ts.net
WEB_PUSH_VAPID_SUBJECT=mailto:operator@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# AI에게 보낼 최근 대화 개수 (기본 10)
CONTEXT_N=10

# Codex 정리 실행
# codex: Codex CLI 사용 / heuristic: 로컬 fallback 정리
# systemd 운영에서는 로그인 셸과 PATH가 다르므로 bare `codex`를 쓰지 않는다.
# 실제 실행을 확인한 절대 wrapper 경로를 사용한다. Pi 예: /home/pi/galpi/bin/codex
# 로컬 개발에서는 `command -v codex`로 찾은 절대 경로에 맞게 교체한다.
CODEX_RUNNER_MODE=codex
CODEX_BIN=/home/pi/galpi/bin/codex
CODEX_RUNNER_TIMEOUT_MS=180000

# Codex 정리에 쓰는 모델 (deep은 /organize all 같은 일괄 재정리용)
CODEX_MODEL=gpt-5.6-terra
CODEX_DEEP_MODEL=gpt-5.5

# 백업 저장 폴더 (볼트+DB 하루 1회 자동 백업, 7일 보관)
# 미설정 시 기본값: ~/backups/galpi
BACKUP_DIR=

# Docker Compose host 설정. Linux는 id -u / id -g 값으로 맞춘다.
GALPI_UID=1000
GALPI_GID=1000
GALPI_PORT=3000
GALPI_DATA_HOST_PATH=./.docker-data/db
GALPI_VAULT_HOST_PATH=./galpi-vault
GALPI_BACKUP_HOST_PATH=./.docker-data/backups

# H1 반이중 음성. 실기기 인수 전까지 false 유지
VOICE_HALFDUPLEX_ENABLED=false
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=echo
# 전달 방식만 지시한다. 비우면 코드 기본 지시문을 쓴다.
VOICE_TTS_INSTRUCTIONS=
