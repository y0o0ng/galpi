# API 키 — 실제 키로 교체 (따옴표 없이 입력)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# 모델 이름 — 오류 나면 각 콘솔에서 최신 모델명으로 교체
CLAUDE_MODEL=claude-sonnet-4-6
GPT_MODEL=gpt-4o

# 볼트 경로 — 옵시디언 폴더의 절대 경로
VAULT_PATH=/Users/chanyongs21/Desktop/ai-council/ai-council-vault

# 서버 포트 (기본 3000)
PORT=3000

# AI에게 보낼 최근 대화 개수 (기본 10)
CONTEXT_N=10
