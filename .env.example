# API 키 — 실제 키로 교체 (따옴표 없이 입력)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# 모델 이름 — 오류 나면 각 콘솔에서 최신 모델명으로 교체
CLAUDE_MODEL=claude-sonnet-4-6
GPT_MODEL=gpt-5.4-mini

# 볼트 경로 — 옵시디언 폴더의 절대 경로
VAULT_PATH=/Users/chanyongs21/Desktop/ai-council/ai-council-vault

# 서버 바인딩
# 로컬 개발: 127.0.0.1
# 라즈베리파이에서 같은 네트워크 기기로 접속: 0.0.0.0
HOST=127.0.0.1

# 서버 포트 (기본 3000)
PORT=3000

# AI에게 보낼 최근 대화 개수 (기본 10)
CONTEXT_N=10

# Codex 정리 실행
# codex: Codex CLI 사용 / heuristic: 로컬 fallback 정리
CODEX_RUNNER_MODE=codex
CODEX_BIN=codex
CODEX_RUNNER_TIMEOUT_MS=180000
CODEX_AUTO_QUEUE_THRESHOLD=5
